PROJECT_NAME="WhatsApp FastAPI 2026 Template"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
APP_BASE_URL="http://localhost:8000"
CLIENT_APP_URL="http://localhost:3000"
PASSWORD_SETUP_URL="http://localhost:3000/set-password"
ADMIN_PASSWORD_SETUP_CODE_EXPIRE_HOURS="2"
ENVIRONMENT="local"
OPENAPI_ENABLED=false
STRUCTURED_LOGGING_ENABLED=true

# -----------------------------------------------------------------------------
# Database — first boot uses sqlite. Prefer postgres:// for staging/production
# (postgresql:// is auto-normalized to postgres://).
# Example: postgres://USER:PASSWORD@127.0.0.1:5432/app
# -----------------------------------------------------------------------------
DATABASE_URL="sqlite://db.sqlite3"

# Comma-separated origins (no JSON arrays).
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# -----------------------------------------------------------------------------
# MUST SET for staging/production — 32+ chars, not placeholders.
# Generate: uv run python scripts/generate_secrets.py --write .env
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=""
OTP_HMAC_SECRET=""
# Deprecated alias used only when JWT_SECRET_KEY / OTP_HMAC_SECRET are unset.
API_AUTHORIZATION_TOKEN="change-me-in-real-projects"

# Comma-separated proxy/load-balancer IPs that may set X-Forwarded-For (leave empty for direct clients).
TRUSTED_PROXY_IPS=""

OTP_RESEND_COOLDOWN_SECONDS="60"
DEV_OUTBOX_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URL=""
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_REGISTER="5/minute"
RATE_LIMIT_OTP_SEND="3/minute"
RATE_LIMIT_OTP_VERIFY="10/minute"
RATE_LIMIT_REFRESH="30/minute"
RATE_LIMIT_CONTACT="3/minute"
RATE_LIMIT_ACCESS="60/minute"
RATE_LIMIT_CLIENT_ERRORS="30/minute"
RATE_LIMIT_UPDATE_POLICY="60/minute"
INTERNAL_JOB_TOKEN=""

# Email / contact / legal settings
BRAND_NAME=""
BRAND_LOGO_URL=""
# Optional email brand palette (hex). Defaults: primary #2563EB, dark #111827, on-primary #FFFFFF
BRAND_PRIMARY_COLOR=""
BRAND_DARK_COLOR=""
BRAND_ON_PRIMARY_COLOR=""
SUPPORT_EMAIL=""
EMAIL_SENDER="noreply@example.com"
CONTACT_RECIPIENT_EMAIL="info@example.com"
RESEND_API_KEY=""
# Store / in-app legal pages (served by GET /api/v1/app/legal)
TERMS_URL="https://example.com/terms"
PRIVACY_URL="https://example.com/privacy"

# Cloudflare R2 (optional until you enable file uploads)
R2_ENDPOINT_URL=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Paystack (supported integration, not required for first boot)
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_CALLBACK_URL=""
PAYSTACK_SUBACCOUNT_PERCENTAGE_CHARGE="0.5"
PAYSTACK_BANKS_JSON_PATH=""

# Prembly (supported integration, not required for first boot)
PREMBLY_SECRET_KEY=""
PREMBLY_PUBLIC_KEY=""
PREMBLY_BASE_URL="https://api.prembly.com"
PREMBLY_NIN_PATH="/verification/vnin-basic"
PREMBLY_TIMEOUT_SECONDS="30"

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (PyWa). Leave WHATSAPP_ENABLED=false for first boot.
# When true, all WHATSAPP_* secrets below are required.
# Meta webhook URL should be: {WHATSAPP_CALLBACK_URL or APP_BASE_URL}{WHATSAPP_WEBHOOK_ENDPOINT}
# -----------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_GRAPH_VERSION=""
WHATSAPP_CALLBACK_URL=""
WHATSAPP_AUTO_REGISTER_CALLBACK=false
WHATSAPP_WEBHOOK_ENDPOINT="/api/v1/webhooks/whatsapp"
WHATSAPP_DISPLAY_NUMBER=""
WHATSAPP_MEDIA_MAX_BYTES=25000000
WHATSAPP_SERVICE_WINDOW_HOURS=24
WHATSAPP_OUTBOUND_MAX_ATTEMPTS=3
# Comma-separated allowlists for inbound media download safety
WHATSAPP_MEDIA_FETCH_ALLOWLIST_HOSTS="graph.facebook.com,graph.whatsapp.com,lookaside.fbsbx.com"
WHATSAPP_MEDIA_ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,audio/ogg,audio/mpeg,audio/aac,application/pdf"
RATE_LIMIT_WHATSAPP_WEBHOOK="240/minute"

# Optional media helpers (describe/transcribe). Stubbed when false.
GEMINI_ENABLED=false
GEMINI_API_KEY=""
